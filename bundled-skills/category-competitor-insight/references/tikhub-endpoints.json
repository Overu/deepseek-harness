      "parameter_transport": "query",
      "required_parameters": ["keyword_list", "start_date", "end_date"],
      "parameters": {
        "keyword_list": {"location": "query", "format": "comma_separated"},
        "start_date": {"location": "query", "format": "YYYYMMDD"},
        "end_date": {"location": "query", "format": "YYYYMMDD"}
      },
      "price_usd": 0.002
    },
    {
      "name": "douyin_hot_total_list",
      "path": "/api/v1/douyin/billboard/fetch_hot_total_list",
      "method": "GET",
      "status": "live",
      "last_verified_at": "2026-09-21",
      "parameter_transport": "query",
      "required_parameters": ["type"],
      "parameters": {
        "type": {"location": "query", "allowed": ["range", "snapshot"]},
        "start_date": {"location": "query", "required_when": "type=range"},
        "end_date": {"location": "query", "required_when": "type=range"},
        "snapshot_time": {"location": "query", "required_when": "type=snapshot"}
      },
      "notes": "实测 type=range 加 start_date/end_date 可返回数据；snapshot 未传 snapshot_time 时可能为空。",
      "price_usd": 0.002
    },
    {

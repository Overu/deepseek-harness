{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/contexts/AuthContext": ["src/auth-context.tsx"],
      "@/routes": ["src/canvas-router.tsx"],
      "@/*": ["legacy/src/*"]
    }
  },
  "include": ["src", "legacy/src/vite-env.d.ts", "legacy/src/types/ali-oss.d.ts", "vite.config.ts"]
}

{
  "name": "@insight-ai/desktop-media-upload-plugin",
  "version": "0.2.2-alpha.2",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Insight Desktop user attachment upload to OSS",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },

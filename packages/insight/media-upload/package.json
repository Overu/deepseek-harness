  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@insight-ai/desktop-integration": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@insight-ai/desktop-integration": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "5.9.2"
  },
  "dependencies": { "@deepseek-ai/schemastery": "workspace:~", "ali-oss": "6.20.0", "zod": "4.4.3" },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml", "README.md", "README.zh.md"],
  "scripts": { "bundle": "tsdown", "typecheck": "tsc -b tsconfig.json" }

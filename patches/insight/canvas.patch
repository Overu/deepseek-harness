-      // 第一优先级：尝试在打平的字典中快速建立映射
-      if (valueMap[stringVal]) {
-        return valueMap[stringVal];
-      }
-
-      // 降级处理容错：针对特殊字段拼单位
-      if (key === 'duration' && typeof val === 'number') return `${val}s`;

new file mode 100644
index 0000000..d656513
--- /dev/null
+++ b/src/shared/upload/errors.ts
@@ -0,0 +1,63 @@
+export type UploadErrorCode =
+  | 'INVALID_FILE'
+  | 'USER_NOT_READY'
+  | 'STS_REQUEST_FAILED'
+  | 'INVALID_STS_RESPONSE'
+  | 'STS_EXPIRED'
+  | 'OSS_AUTH_FAILED'
+  | 'OSS_CORS_FAILED'
+  | 'NETWORK_ERROR'
+  | 'TIMEOUT'
+  | 'CANCELLED'
+  | 'UPLOAD_FAILED'
+  | 'PUBLIC_URL_MISSING';
+
+export class UploadError extends Error {
+  code: UploadErrorCode;
+  retryable: boolean;
+  override cause?: unknown;
+
+  constructor(code: UploadErrorCode, message: string, options?: { retryable?: boolean; cause?: unknown }) {
+    super(message);
+    this.name = 'UploadError';
+    this.code = code;
+    this.retryable = options?.retryable ?? false;
+    this.cause = options?.cause;
+  }
+}
+
+const getErrorField = (error: unknown, field: string) => {
+  if (!error || typeof error !== 'object') return undefined;
+  return (error as Record<string, unknown>)[field];
+};
+
+export function toUploadError(error: unknown): UploadError {
+  if (error instanceof UploadError) return error;
+
+  const name = String(getErrorField(error, 'name') || '');
+  const code = String(getErrorField(error, 'code') || '');
+  const status = Number(getErrorField(error, 'status') || 0);
+  const message = String(getErrorField(error, 'message') || '文件上传失败');
+
+  if (name === 'AbortError' || name === 'cancel' || code === 'CANCELLED') {
+    return new UploadError('CANCELLED', '已取消上传', { cause: error });
+  }
+
+  if (status === 403 || ['AccessDenied', 'InvalidAccessKeyId', 'SecurityTokenExpired', 'InvalidSecurityToken'].includes(code)) {
+    return new UploadError('OSS_AUTH_FAILED', '上传凭证无效或没有文件上传权限', { retryable: true, cause: error });
+  }
+
+  if (/cors/i.test(message)) {
+    return new UploadError('OSS_CORS_FAILED', '对象存储跨域配置错误', { cause: error });
+  }
+
+  if (name === 'TimeoutError' || /timeout/i.test(message)) {
+    return new UploadError('TIMEOUT', '文件上传超时，请重试', { retryable: true, cause: error });
+  }
+
+  if (name === 'TypeError' || /failed to fetch|network/i.test(message)) {
+    return new UploadError('NETWORK_ERROR', '网络异常，请检查网络后重试', { retryable: true, cause: error });
+  }
+
+  return new UploadError('UPLOAD_FAILED', message || '文件上传失败', { retryable: true, cause: error });
+}
diff --git a/src/shared/upload/policies.ts b/src/shared/upload/policies.ts
new file mode 100644
index 0000000..502ac4d
--- /dev/null
+++ b/src/shared/upload/policies.ts
@@ -0,0 +1,48 @@
+import { UploadError } from './errors.ts';
+import type { UploadPolicy, UploadValidationResult } from './types.ts';
+
+const getExtension = (fileName: string) => {
+  const index = fileName.lastIndexOf('.');
+  return index >= 0 ? fileName.slice(index).toLowerCase() : '';
+};
+
+const matchesMimeType = (mimeType: string, allowedType: string) => {
+  if (allowedType.endsWith('/*')) {
+    return mimeType.startsWith(allowedType.slice(0, -1));
+  }
+  return mimeType === allowedType;
+};
+
+export function validateUploadFile(file: File, policy?: UploadPolicy): UploadValidationResult {
+  if (!file || !file.name) {
+    return { valid: false, message: '请选择有效文件' };
+  }
+  if (!policy) return { valid: true };
+
+  if (policy.maxSizeBytes !== undefined) {
+    const exceedsLimit = policy.sizeBoundary === 'exclusive' ? file.size >= policy.maxSizeBytes : file.size > policy.maxSizeBytes;
+    if (exceedsLimit) {
+      return { valid: false, message: '文件大小超过限制' };
+    }
+  }
+
+  const hasMimeRules = Boolean(policy.allowedMimeTypes?.length);
+  const hasExtensionRules = Boolean(policy.allowedExtensions?.length);
+  if (hasMimeRules || hasExtensionRules) {
+    const mimeAllowed = policy.allowedMimeTypes?.some(type => matchesMimeType(file.type.toLowerCase(), type.toLowerCase())) ?? false;
+    const extension = getExtension(file.name);
+    const extensionAllowed = policy.allowedExtensions?.some(item => item.toLowerCase() === extension) ?? false;
+    if (!mimeAllowed && !extensionAllowed) {
+      return { valid: false, message: '不支持的文件类型' };
+    }
+  }
+
+  return { valid: true };
+}
+
+export function assertUploadFile(file: File, policy?: UploadPolicy): void {
+  const validation = validateUploadFile(file, policy);
+  if (!validation.valid) {
+    throw new UploadError('INVALID_FILE', validation.message);
+  }
+}

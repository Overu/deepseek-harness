-  const sent = [...SOURCE_PATCH.matchAll(/([a-zA-Z]+):\s*draft\.\1/g)].map((m) => m[1]).sort()
-  assert.deepEqual(sent, fields, 'RuntimeConfig 声明了字段但 saveConfig 没发送（或反之）')
-})

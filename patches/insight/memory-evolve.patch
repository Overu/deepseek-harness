-      body: body !== undefined ? JSON.stringify(body) : undefined,
-    })
-    const data = await res.json().catch(() => ({}))
-    return { status: res.status, data }
-  }
-  return {
-    base, todoStore, dir, request,
-    close: () => new Promise((resolve) => server.close(resolve)),
-  }

-/** 测试用 rig 工厂：t.after 统一清理（dispose + 删目录），防 claim 泄漏。 */
-function rigFor(t, overrides) {
-  const rig = makeRig(overrides)
-  t.after(() => {
-    try { rig.installed.dispose() } catch { /* 忽略清理错误 */ }
-    try { rmSync(rig.dir, { recursive: true, force: true }) } catch { /* 忽略 */ }
-  })
-  return rig
-}

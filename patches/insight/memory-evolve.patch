-/** 旧实现（缺陷版）的逐块解码：仅用于测试前提自检，不参与生产代码。 */
-function legacyChunkDecode(chunks) {
-  let text = ''
-  for (const chunk of chunks) text += String(chunk) // 等价于 chunk.toString('utf8')
-  return text
-}

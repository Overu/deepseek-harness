-  installApi(ctx, {
-    store: { add: () => ({ ok: true, message: 'ok' }) },
-    archive, queue, todoStore,
-    getRuntime: () => runtime,
-    updateRuntime: (patch) => patch,
-    config: { memoryDir: dir, skillDir: join(dir, 'skills') },
-    resolveCwd: (sessionId) => (sessionId === 's1' ? '/proj/api' : undefined),

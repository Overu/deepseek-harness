-    assert.ok(aInjects[0].content[0].text.includes('A'), '包含完整会话 ID')
-    assert.ok(!aInjects[0].content[0].text.includes('并行已结束'), '首次进入 running（活跃 1）不得误发「并行已结束」')
-    // 无状态变化：再触发一次 status（同状态）→ 不重复投递（状态驱动稳定）

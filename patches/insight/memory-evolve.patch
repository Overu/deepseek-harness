- * consumer：clone 后 checkout --detach v1.0.0（旧版本安装现场）。
- */
-function setupRepo() {
-  const root = tempRoot()
-  const origin = join(root, 'origin.git')
-  const dev = join(root, 'dev')
-  const consumer = join(root, 'consumer')
-  sh(root, ['init', '--bare', '-q', origin])
-  mkdirSync(dev)
